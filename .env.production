# Configuration pour PRODUCTION (PythonAnywhere)
# Renommez ce fichier en .env sur PythonAnywhere et remplissez les valeurs

# Base de données MySQL (PythonAnywhere)
USE_SQLITE=False
MYSQL_HOST=YOUR_USERNAME.mysql.pythonanywhere-services.com
MYSQL_USER=YOUR_USERNAME
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
MYSQL_DB=YOUR_USERNAME$gestion_enseignement
MYSQL_PORT=3306

# Flask Configuration
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY
FLASK_DEBUG=False
FLASK_ENV=production