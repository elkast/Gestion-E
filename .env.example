# Configuration de l'application
# Copiez ce fichier en .env et modifiez selon vos besoins

# Environnement (developpement, portable, production)
ENVIRONNEMENT_FLASK=portable

# Utiliser SQLite (true) ou MySQL (false)
UTILISER_SQLITE=true

# Nom du fichier SQLite (dans le dossier data/)
NOM_DB_SQLITE=gestion.db

# Clé secrète Flask (changez cette valeur en production)
CLE_SECRETE=votre_cle_secrete_unique_ici_12345

# Configuration MySQL (si UTILISER_SQLITE=false)
HOTE_MYSQL=localhost
UTILISATEUR_MYSQL=root
MOT_DE_PASSE_MYSQL=
NOM_DB_MYSQL=gestion_enseignement
PORT_MYSQL=3306